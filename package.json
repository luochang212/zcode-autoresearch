{
  "name": "zcode-autoresearch",
  "private": true,
  "type": "module",
  "description": "Dev tooling (lint/format/hooks/CI) for the zcode autoresearch plugin repo. The plugin itself stays zero-dependency.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "cd plugin && node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.0.0",
    "adr-kit": "^0.5.0",
    "eslint": "^9.39.2",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ],
    "*.sh": [
      "bash -n"
    ]
  }
}
